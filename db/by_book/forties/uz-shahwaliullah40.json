{
  "id": 12,
  "metadata": {
    "id": 12,
    "length": 40,
    "arabic": {
      "title": "أربعون ولي الله الدهلوي",
      "author": "الشاه ولي الدين الدهلوي",
      "introduction": ""
    },
    "uzbek": {
      "title": "Shoh Valiulloh Dehlaviyning \"Arbain\"lari",
      "author": "Shoh Valiyulloh Dehlaviy"
    }
  },
  "chapters": [
    {
      "id": 0,
      "bookId": 12,
      "arabic": "أربعون شاه ولي الله الدهلوي",
      "uzbek": "Shoh Valiyulloh Dehlaviyning \"Arbaʼin\"lari"
    }
  ],
  "hadiths": [
    {
      "id": 41026,
      "idInBook": 1,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "لَیْسَ الْخَبَرُ کَالْمُعَایَنَةِ",
      "uzbek": {
        "narrator": "",
        "text": "Xabar ko'z bilan ko'rgandek bo'lmaydi."
      }
    },
    {
      "id": 41027,
      "idInBook": 2,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "الْحَرْبُ خُدَعَةٌ",
      "uzbek": {
        "narrator": "Ali roziyallohu anhu",
        "text": "Urush - hiyladir."
      }
    },
    {
      "id": 41028,
      "idInBook": 3,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "الْمُسْلِمُ مِرْآةُ الْمُسْلِمِ",
      "uzbek": {
        "narrator": "Abu Hurayra roziyallohu anhu",
        "text": "Musulmon musulmonning oynasidir."
      }
    },
    {
      "id": 41029,
      "idInBook": 4,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "الْمُسْتَشَارُ مُؤتَمَنٌ",
      "uzbek": {
        "narrator": "",
        "text": "Maslahat so'ralgan kishi omonatdordir."
      }
    },
    {
      "id": 41030,
      "idInBook": 5,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "الدَّالُّ عَلَی الْخَیْرِ کَفَاعِلِهِ",
      "uzbek": {
        "narrator": "Abu Mas'ud al-Badriy roziyallohu anhu",
        "text": "Yaxshilikka dalolat qiluvchi (uni boshqalarga ko'rsatib qo'yuvchi) ana shu yaxshilikni qiluvchi kabi (savobga ega bo'lur)."
      }
    },
    {
      "id": 41031,
      "idInBook": 6,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "إِسْتَعِیْنُوْا عَلَی الْحَوَائِجِ بِالْکِتْمَانِ",
      "uzbek": {
        "narrator": "Ali roziyallohu anhu",
        "text": "Ehtiyojlaringizni bajarishda uning yashirin bo'lishidan yordam oling."
      }
    },
    {
      "id": 41032,
      "idInBook": 7,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "إِتَّقُوْا النَّارَ وَلَوْ بِشِقِّ تَمْرَةٍ",
      "uzbek": {
        "narrator": "Adiy ibn Hotam roziyallohu anhu",
        "text": "Yarim ta’zo (xurmo) bo‘lsa ham, sadaqa qilib bo‘lsa-da, o‘zingizni do‘zax o‘tidan saqlangiz!"
      }
    },
    {
      "id": 41033,
      "idInBook": 8,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "الدُّنْیَا سِجْنُ الْمُؤمِنِ وَ جَنَّةُ الْکَافِرِ",
      "uzbek": {
        "narrator": "Abu Hurayra roziyallohu anhu",
        "text": "Dunyo mo'minning zindoni, kofirning jannatidir."
      }
    },
    {
      "id": 41034,
      "idInBook": 9,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "الْحَیَاءُ خَیْرٌ کُلُّهُ",
      "uzbek": {
        "narrator": "",
        "text": "Hayo(ning barchasi) yaxshilikdir."
      }
    },
    {
      "id": 41035,
      "idInBook": 10,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "عِدَةُ الْمُؤمِنِ کَاَخْذِ الْکَفِّ",
      "uzbek": {
        "narrator": "Rasululloh sollallohu alayhi vasallam",
        "text": "Mo'minning va'dasi qo'lga olgandek (qat'iy va bajarilishi shart)dir."
      }
    },
    {
      "id": 41036,
      "idInBook": 11,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "لَا یَحِلُّ لِمُؤمِنٍ اَنْ یَّجُهْرَ أخَاهُ فَوقَ ثَلَاثَةِ أیَّامٍ",
      "uzbek": {
        "narrator": "Abu Ayyub al-Ansoriy roziyallohu anhu",
        "text": "Mo'min kishiga o'z birodarini uch kundan ortiq tark etishi (gaplashmay yurishi) halol emas."
      }
    },
    {
      "id": 41037,
      "idInBook": 12,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "لَیْسَ مِنَّا مَنْ غَشَّنَا",
      "uzbek": {
        "narrator": "Abu Hurayra roziyallohu anhu",
        "text": "Bizni aldagan kishi bizdan emas."
      }
    },
    {
      "id": 41038,
      "idInBook": 13,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "مَا قَلَّ وَكَفَى خَيْرٌ مِمَّا كَثُرَ وَأَلْهَى",
      "uzbek": {
        "narrator": "Abu Umoma roziyallohu anhu",
        "text": "Oz bo'lib, kifoya qilgani ko'p bo'lib, (Allohni zikr qilishdan) chalg'itganidan yaxshiroqdir."
      }
    },
    {
      "id": 41039,
      "idInBook": 14,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "الرَّاجِعُ فِيْ هِبَتِهِ کَالرَّاجِعِ فِيْ قَیْئِهِ",
      "uzbek": {
        "narrator": "Ibn Abbos va Ibn Umar roziyallohu anhumo",
        "text": "O'z hadyasidan qaytgan kishi qusug'iga qaytib, uni yegan kishiga o'xshaydi."
      }
    },
    {
      "id": 41040,
      "idInBook": 15,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "الْبَلَاءُ مُوَکِّلٌ بِالْمَنْطِقِ",
      "uzbek": {
        "narrator": "",
        "text": "Sinov (balo) so'zga bog'langandir."
      }
    },
    {
      "id": 41041,
      "idInBook": 16,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "النَّاسُ کَأسْنَانِ الْمُشْطِ",
      "uzbek": {
        "narrator": "",
        "text": "Odamlar taroqning tishlaridek barobardirlar."
      }
    },
    {
      "id": 41042,
      "idInBook": 17,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "الْغِنَى غِنَى النَّفْسِ",
      "uzbek": {
        "narrator": "Abu Hurayra roziyallohu anhu",
        "text": "Boylik bu – nafs boyligidir."
      }
    },
    {
      "id": 41043,
      "idInBook": 18,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "الْسَّعِیْدُ مَنْ وُّعِظَ بِغَیْرِهِ",
      "uzbek": {
        "narrator": "Luqmon Hakim",
        "text": "Baxtli kishi boshqalarning holatidan va'z-nasihat olgan kishidir."
      }
    },
    {
      "id": 41044,
      "idInBook": 19,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "وَ إِنَّ مِنَ الشِّعْرِ لَحِکْمَةً وَاِنَّ مِنَ الْبَیَانِ لَسِحْرًا",
      "uzbek": {
        "narrator": "",
        "text": "Albatta, she'rlardan ham hikmatlilar bor va albatta, bayonning ham sehrli (ta'sirli) turlari bor."
      }
    },
    {
      "id": 41045,
      "idInBook": 20,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "عَفْوُ الْمُلُوْكِ إِبْقَاءٌ لِلْمُلْكِ",
      "uzbek": {
        "narrator": "",
        "text": "Podshohlarning kechirimli bo'lishi mulkning bardavom bo'lishidir."
      }
    },
    {
      "id": 41046,
      "idInBook": 21,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "اَلْمَرْءُ مَعَ مَنْ أَحَبَّ",
      "uzbek": {
        "narrator": "Abu Mus'ar roziyallohu anhu",
        "text": "Kishi o'zi sevgan kishisi bilan birgadir."
      }
    },
    {
      "id": 41047,
      "idInBook": 22,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "مَا هَلَكَ إمْرُؤٌ عَرَفَ قَدْرَهُ",
      "uzbek": {
        "narrator": "Ali ibn Abu Tolib roziyallohu anhu",
        "text": "O'z qadrini (imkoniyati va haddini) bilgan kishi halok bo'lmaydi."
      }
    },
    {
      "id": 41048,
      "idInBook": 23,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "اَلْوَلَدُ لِلْفِرَاشِ وَ لِلْعَاهِرِ الْحَجَرُ",
      "uzbek": {
        "narrator": "Abu Hurayra roziyallohu anhu",
        "text": "Farzand to‘shak egasiniki (nikohli erga tegishli), zohiyga (zinokorga) esa mahrumlik (toshbo‘ron yoki hech narsa yo‘q) bor."
      }
    },
    {
      "id": 41049,
      "idInBook": 24,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "الْیَدُ الْعُلْیَا خَیْرٌ مِّنَ الْیَدِ السُّفْلَی",
      "uzbek": {
        "narrator": "Abu Hurayra roziyallohu anhu",
        "text": "Beruvchi qo'l oluvchi qo'ldan yaxshiroqdir."
      }
    },
    {
      "id": 41050,
      "idInBook": 25,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "لَا شَکَرَ اللهَ مَنْ لَّا یَشْکُرُ النَّاسَ",
      "uzbek": {
        "narrator": "Abu Hurayra roziyallohu anhu",
        "text": "Odamlarga tashakkur keltirmagan kishi Allohga ham shukr qilmagan bo'ladi."
      }
    },
    {
      "id": 41051,
      "idInBook": 26,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "حُبُّكَ الشَّيْءَ یُعْمِيْ وَ یُصِمُّ",
      "uzbek": {
        "narrator": "Abu Dardo roziyallohu anhu",
        "text": "Biror narsani qattiq sevgining kuchi (ko'zni) ko'r, (quloqni) kar qiladi."
      }
    },
    {
      "id": 41052,
      "idInBook": 27,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "جُبِلَتِ الْقُلُوبُ عَلی حُبَّ مَنْ اَحْسَنَ اِلَیْهَا وَ بُغْضِ مَنْ اَسَاءَ اِلَیْهَا",
      "uzbek": {
        "narrator": "",
        "text": "Qalb yaxshilik qilganni sevishga, yomonlik qilganni yomon ko'rishga tabiatan moyil qilib yaratilgandir."
      }
    },
    {
      "id": 41053,
      "idInBook": 28,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "الْتَّائِبُ مِنَ الذَّنْبِ کَمَنْ لَا ذَنْبَ لَهُ",
      "uzbek": {
        "narrator": "Ibn Mas'ud roziyallohu anhu",
        "text": "Gunohdan tavba qiluvchi gunohi yo'q kabi bo'ladi."
      }
    },
    {
      "id": 41054,
      "idInBook": 29,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "الشَّاهِدُ یَرَی مَا لَا یَرَاهُ الْغَائِبُ",
      "uzbek": {
        "narrator": "Noma'lum roviy",
        "text": "Hozir bo'lgan kishi g'oyib (hozir bo'lmagan) kishi ko'rmagan narsani ko'radi."
      }
    },
    {
      "id": 41055,
      "idInBook": 30,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "اِذا جَاءَکُمْ کَرِیْمُ قَوْمٍ فَاَکْرِمُوهُ",
      "uzbek": {
        "narrator": "Noma'lum",
        "text": "Agar huzuringizga bir qavmning ulug' (hurmatga loyiq) kishisi kelsa, uni hurmat qiling."
      }
    },
    {
      "id": 41056,
      "idInBook": 31,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "الْیَمِینُ الْفَاجِرَةُ تَدَعُ الدِّیَارَ الْبَلَاقِعَ",
      "uzbek": {
        "narrator": "Abu Hurayra roziyallohu anhu",
        "text": "Yolg'on qasamyod qilish (egalarini halok etib) uylarni kimsasiz xarobaga aylantiradi."
      }
    },
    {
      "id": 41057,
      "idInBook": 32,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "مَنْ قُتِلَ دُونَ مَالِهِ فَهُوَ شَهِیْدٌ",
      "uzbek": {
        "narrator": "Sa'id ibn Zayd roziyallohu anhu",
        "text": "Kim mol-mulorini himoya qilish yo'lida o'ldirilsa, u shahiddir."
      }
    },
    {
      "id": 41058,
      "idInBook": 33,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "الْاَعْمَالُ بِالنِّیَّةِ",
      "uzbek": {
        "narrator": "Umar ibn Xattob roziyallohu anhu",
        "text": "Amallar niyatga ko‘radir."
      }
    },
    {
      "id": 41059,
      "idInBook": 34,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "سَیِّدُ الْقَوْمِ خَادِمُهُمْ",
      "uzbek": {
        "narrator": "Ali roziyallohu anhu",
        "text": "Qavmning sayidsiz (rahbari) – ularning xizmatkoridir."
      }
    },
    {
      "id": 41060,
      "idInBook": 35,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "خَیْرُ الْأُمُوْرِ أَوْسَطُهَا",
      "uzbek": {
        "narrator": "Noma'lum",
        "text": "Ishlarning eng yaxshisi — o'rtachasidir."
      }
    },
    {
      "id": 41061,
      "idInBook": 36,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "اَللَّهُمَّ بَارِكْ فِیْ أُمَّتِیْ فِی بُکُوْرِهَا یَوْمَ الْخَمِیْسِ",
      "uzbek": {
        "narrator": "Ali roziyallohu anhu",
        "text": "Ey Allohim, ummatimga ularning payshanba kungi erta tonglarida baraka bergin."
      }
    },
    {
      "id": 41062,
      "idInBook": 37,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "کَادَ الْفَقْرُ أَنْ یَکُوْنَ کُفْرًا",
      "uzbek": {
        "narrator": "Ali ibn Abu Tolib roziyallohu anhu",
        "text": "Faqirlik deyarli kufr bo'lishiga oz qoldi."
      }
    },
    {
      "id": 41063,
      "idInBook": 38,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "الْسَّفَرُ قِطْعَةٌ مِّنَ الْعَذَابِ",
      "uzbek": {
        "narrator": "Abu Hurayra roziyallohu anhu",
        "text": "Safar azobdan bir parchedir."
      }
    },
    {
      "id": 41064,
      "idInBook": 39,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "خَیْرُ زَّادِ الْتَّقْوَی",
      "uzbek": {
        "narrator": "Noma'lum",
        "text": "Eng yaxshi ozuqa taqvodir."
      }
    },
    {
      "id": 41065,
      "idInBook": 40,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "الْمَجَالِسُ بِالْاَمَانَةِ",
      "uzbek": {
        "narrator": "",
        "text": "Majlislar omonatdir."
      }
    }
  ]
}