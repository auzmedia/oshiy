{
  "id": 12,
  "metadata": {
    "id": 12,
    "length": 40,
    "arabic": {
      "title": "أربعون ولي الله الدهلوي",
      "author": "الشاه ولي الدين الدهلوي",
      "introduction": ""
    },
    "uzbek": {
      "title": "Shoh Valiyulloh Dahlaviyning qirq hadisi",
      "author": "Shoh Valiyuddin Dahlaviy",
      "introduction": ""
    }
  },
  "chapters": [
    {
      "id": 0,
      "bookId": 12,
      "arabic": "أربعون شاه ولي الله الدهلوي",
      "uzbek": "Shoh Valiyulloh Dahlaviyning qirq hadisi"
    }
  ],
  "hadiths": [
    {
      "id": 41026,
      "idInBook": 1,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "لَیْسَ الْخَبَرُ کَالْمُعَایَنَةِ",
      "uzbek": {
        "narrator": "",
        "text": "Xabar ko'rish bilan bir xil emas."
      }
    },
    {
      "id": 41027,
      "idInBook": 2,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "الْحَرْبُ خُدَعَةٌ",
      "uzbek": {
        "narrator": "",
        "text": "Urush — hiyla-nayrangdir."
      }
    },
    {
      "id": 41028,
      "idInBook": 3,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "الْمُسْلِمُ مِرْآةُ الْمُسْلِمِ",
      "uzbek": {
        "narrator": "",
        "text": "Musulmon musulmonning oynasidir."
      }
    },
    {
      "id": 41029,
      "idInBook": 4,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "الْمُسْتَشَارُ مُؤتَمَنٌ",
      "uzbek": {
        "narrator": "",
        "text": "Maslahat so'ralgan kishi ishonchli (omonatdor)dir."
      }
    },
    {
      "id": 41030,
      "idInBook": 5,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "الدَّالُّ عَلَی الْخَیْرِ کَفَاعِلِهِ",
      "uzbek": {
        "narrator": "",
        "text": "Yaxshilikka yo'l ko'rsatgan kishi, uni qilgan kishi kabidir."
      }
    },
    {
      "id": 41031,
      "idInBook": 6,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "إِسْتَعِیْنُوْا عَلَی الْحَوَائِجِ بِالْکِتْمَانِ",
      "uzbek": {
        "narrator": "",
        "text": "Ehtiyojlaringizda yashirinlik bilan yordam so'ranglar."
      }
    },
    {
      "id": 41032,
      "idInBook": 7,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "إِتَّقُوْا النَّارَ وَلَوْ بِشِقِّ تَمْرَةٍ",
      "uzbek": {
        "narrator": "",
        "text": "Do'zaxdan hatto yarim xurmo bilan bo'lsa ham saqlaninglar."
      }
    },
    {
      "id": 41033,
      "idInBook": 8,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "الدُّنْیَا سِجْنُ الْمُؤمِنِ وَ جَنَّةُ الْکَافِرِ",
      "uzbek": {
        "narrator": "",
        "text": "Dunyo mo'minning qamoqxonasi, kofirning jannatidir."
      }
    },
    {
      "id": 41034,
      "idInBook": 9,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "الْحَیَاءُ خَیْرٌ کُلُّهُ",
      "uzbek": {
        "narrator": "",
        "text": "Hayo — butunlay yaxshilikdir."
      }
    },
    {
      "id": 41035,
      "idInBook": 10,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "عِدَةُ الْمُؤمِنِ کَاَخْذِ الْکَفِّ",
      "uzbek": {
        "narrator": "",
        "text": "Mo'minning va'dasi — qo'l berib ahdlashish kabidir."
      }
    },
    {
      "id": 41036,
      "idInBook": 11,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "لَا یَحِلُّ لِمُؤمِنٍ اَنْ یَّجُهْرَ أخَاهُ فَوقَ ثَلَاثَةِ أیَّامٍ",
      "uzbek": {
        "narrator": "",
        "text": "Mo'min kishiga birodaridan uch kundan ortiq ajralib yurishi halol emas."
      }
    },
    {
      "id": 41037,
      "idInBook": 12,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "لَیْسَ مِنَّا مَنْ غَشَّنَا",
      "uzbek": {
        "narrator": "",
        "text": "Bizni aldayotgan kishi bizdan emas."
      }
    },
    {
      "id": 41038,
      "idInBook": 13,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "مَا قَلَّ وَكَفَى خَيْرٌ مِمَّا كَثُرَ وَأَلْهَى",
      "uzbek": {
        "narrator": "",
        "text": "Oz bo'lsa ham yetarli bo'lgan narsa, ko'p bo'lib chalg'itgan narsadan yaxshidir."
      }
    },
    {
      "id": 41039,
      "idInBook": 14,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "الرَّاجِعُ فِيْ هِبَتِهِ کَالرَّاجِعِ فِيْ قَیْئِهِ",
      "uzbek": {
        "narrator": "",
        "text": "Hadya qilgan narsasini qaytarib olgan kishi, qusug'ini qayta yegan kishi kabidir."
      }
    },
    {
      "id": 41040,
      "idInBook": 15,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "الْبَلَاءُ مُوَکِّلٌ بِالْمَنْطِقِ",
      "uzbek": {
        "narrator": "",
        "text": "Balo (qiyinchilik) tilga (bo'sh gapga) bog'liqdir."
      }
    },
    {
      "id": 41041,
      "idInBook": 16,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "النَّاسُ کَأسْنَانِ الْمُشْطِ",
      "uzbek": {
        "narrator": "",
        "text": "Odamlar taroq tishlari kabidir (tengdirlar)."
      }
    },
    {
      "id": 41042,
      "idInBook": 17,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "الْغِنَى غِنَى النَّفْسِ",
      "uzbek": {
        "narrator": "",
        "text": "Boylik — nafsning boyligidir (qanoatdir)."
      }
    },
    {
      "id": 41043,
      "idInBook": 18,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "الْسَّعِیْدُ مَنْ وُّعِظَ بِغَیْرِهِ",
      "uzbek": {
        "narrator": "",
        "text": "Baxtli kishi — boshqalardan ibrat olgan kishidir."
      }
    },
    {
      "id": 41044,
      "idInBook": 19,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "وَ إِنَّ مِنَ الشِّعْرِ لَحِکْمَةً وَاِنَّ مِنَ الْبَیَانِ لَسِحْرًا",
      "uzbek": {
        "narrator": "",
        "text": "Albatta, she'rda hikmat bor va bayonda (notiqlikda) sehr bor."
      }
    },
    {
      "id": 41045,
      "idInBook": 20,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "عَفْوُ الْمُلُوْكِ إِبْقَاءٌ لِلْمُلْكِ",
      "uzbek": {
        "narrator": "",
        "text": "Podshohlarning kechirimi — mulkning saqlanishidir."
      }
    },
    {
      "id": 41046,
      "idInBook": 21,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "اَلْمَرْءُ مَعَ مَنْ أَحَبَّ",
      "uzbek": {
        "narrator": "",
        "text": "Kishi sevgan kishisi bilan birgadir."
      }
    },
    {
      "id": 41047,
      "idInBook": 22,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "مَا هَلَكَ إمْرُؤٌ عَرَفَ قَدْرَهُ",
      "uzbek": {
        "narrator": "",
        "text": "O'z qadrini bilgan kishi halok bo'lmaydi."
      }
    },
    {
      "id": 41048,
      "idInBook": 23,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "اَلْوَلَدُ لِلْفِرَاشِ وَ لِلْعَاهِرِ الْحَجَرُ",
      "uzbek": {
        "narrator": "",
        "text": "Bola to'shak egasiga, zinokorga toshdir."
      }
    },
    {
      "id": 41049,
      "idInBook": 24,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "الْیَدُ الْعُلْیَا خَیْرٌ مِّنَ الْیَدِ السُّفْلَی",
      "uzbek": {
        "narrator": "",
        "text": "Yuqori qo'l (beruvchi) pastki qo'ldan (oluvchidan) yaxshidir."
      }
    },
    {
      "id": 41050,
      "idInBook": 25,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "لَا شَکَرَ اللهَ مَنْ لَّا یَشْکُرُ النَّاسَ",
      "uzbek": {
        "narrator": "",
        "text": "Odamlarga shukr qilmagan kishi Allohga ham shukr qilmagan bo'ladi."
      }
    },
    {
      "id": 41051,
      "idInBook": 26,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "حُبُّكَ الشَّيْءَ یُعْمِيْ وَ یُصِمُّ",
      "uzbek": {
        "narrator": "",
        "text": "Bir narsaga bo'lgan muhabbating seni ko'r va kar qilib qo'yadi."
      }
    },
    {
      "id": 41052,
      "idInBook": 27,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "جُبِلَتِ الْقُلُوبُ عَلی حُبَّ مَنْ اَحْسَنَ اِلَیْهَا وَ بُغْضِ مَنْ اَسَاءَ اِلَیْهَا",
      "uzbek": {
        "narrator": "",
        "text": "Qalblar ularga yaxshilik qilganni sevishga va yomonlik qilganni yomon ko'rishga yaratilgandir."
      }
    },
    {
      "id": 41053,
      "idInBook": 28,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "الْتَّائِبُ مِنَ الذَّنْبِ کَمَنْ لَا ذَنْبَ لَهُ",
      "uzbek": {
        "narrator": "",
        "text": "Gunohdan tavba qilgan kishi gunohi yo'q kishi kabidir."
      }
    },
    {
      "id": 41054,
      "idInBook": 29,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "الشَّاهِدُ یَرَی مَا لَا یَرَاهُ الْغَائِبُ",
      "uzbek": {
        "narrator": "",
        "text": "Hozir bo'lgan kishi, g'oyib kishi ko'rmaydigan narsani ko'radi."
      }
    },
    {
      "id": 41055,
      "idInBook": 30,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "اِذا جَاءَکُمْ کَرِیْمُ قَوْمٍ فَاَکْرِمُوهُ",
      "uzbek": {
        "narrator": "",
        "text": "Qavmning ulug' kishisi huzuringizga kelsa, uni hurmat qilinglar."
      }
    },
    {
      "id": 41056,
      "idInBook": 31,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "الْیَمِینُ الْفَاجِرَةُ تَدَعُ الدِّیَارَ الْبَلَاقِعَ",
      "uzbek": {
        "narrator": "",
        "text": "Yolg'on qasam diyorlarni bo'shab qoldiradi."
      }
    },
    {
      "id": 41057,
      "idInBook": 32,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "مَنْ قُتِلَ دُونَ مَالِهِ فَهُوَ شَهِیْدٌ",
      "uzbek": {
        "narrator": "",
        "text": "Kim molini himoya qilishda o'ldirilsa, u shahiddir."
      }
    },
    {
      "id": 41058,
      "idInBook": 33,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "الْاَعْمَالُ بِالنِّیَّةِ",
      "uzbek": {
        "narrator": "",
        "text": "Amallar niyatga bog'liqdir."
      }
    },
    {
      "id": 41059,
      "idInBook": 34,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "سَیِّدُ الْقَوْمِ خَادِمُهُمْ",
      "uzbek": {
        "narrator": "",
        "text": "Qavmning sardori — ularning xizmatkoridir."
      }
    },
    {
      "id": 41060,
      "idInBook": 35,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "خَیْرُ الْأُمُوْرِ أَوْسَطُهَا",
      "uzbek": {
        "narrator": "",
        "text": "Ishlarning eng yaxshisi — o'rtachasidir."
      }
    },
    {
      "id": 41061,
      "idInBook": 36,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "اَللَّهُمَّ بَارِكْ فِیْ أُمَّتِیْ فِی بُکُوْرِهَا یَوْمَ الْخَمِیْسِ",
      "uzbek": {
        "narrator": "",
        "text": "Ey Alloh! Ummatimga payshanba kuni erta tongda baraka ber."
      }
    },
    {
      "id": 41062,
      "idInBook": 37,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "کَادَ الْفَقْرُ أَنْ یَکُوْنَ کُفْرًا",
      "uzbek": {
        "narrator": "",
        "text": "Kambag'allik kufrga yaqin bo'lib qoldi."
      }
    },
    {
      "id": 41063,
      "idInBook": 38,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "الْسَّفَرُ قِطْعَةٌ مِّنَ الْعَذَابِ",
      "uzbek": {
        "narrator": "",
        "text": "Safar — azobning bir bo'lagidir."
      }
    },
    {
      "id": 41064,
      "idInBook": 39,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "خَیْرُ زَّادِ الْتَّقْوَی",
      "uzbek": {
        "narrator": "",
        "text": "Eng yaxshi safar ozug'i — taqvodorlikdir."
      }
    },
    {
      "id": 41065,
      "idInBook": 40,
      "chapterId": 0,
      "bookId": 12,
      "arabic": "الْمَجَالِسُ بِالْاَمَانَةِ",
      "uzbek": {
        "narrator": "",
        "text": "Majlislar — omonatdir."
      }
    }
  ]
}
